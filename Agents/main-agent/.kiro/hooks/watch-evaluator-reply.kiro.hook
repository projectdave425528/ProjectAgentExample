{
  "name": "Watch Evaluator Assignment Reply",
  "version": "1.0.0",
  "when": {
    "type": "fileCreated",
    "patterns": ["../../ProjectRecord/*/outbox/evaluator/assignment-*-reply-verdict.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Evaluator 已完成。先讀取 ../../ProjectRecord/active-project.md 確認當前 Project，然後讀取對應 Project 嘅 evaluator/outbox/ assignment reply，檢查 AssignmentStatus：verdict-pass → 交付；verdict-fail → 重調 Generator；verdict-replan → 重調 Planner。"
  }
}
