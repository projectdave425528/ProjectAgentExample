# WhatsApp 帳目分析系統 - 環境變數配置
# 複製此文件為 .env 並填入實際值

# AI Vision API Key（使用 ai_vision 模式時必填）
AI_VISION_API_KEY=your-openai-api-key-here

# Tesseract OCR 路徑（Windows 需要指定）
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# 分析模式：ocr 或 ai_vision
ANALYSIS_MODE=ocr

# 輸出目錄
OUTPUT_DIR=./output

# 信心度閾值（0.0 - 1.0）
CONFIDENCE_THRESHOLD=0.7
