# WhatsApp 帳目分析系統 — 環境變數配置
# 複製本文件為 .env 並填入實際值

# 分析模式：ocr（免費本地）或 ai_vision（付費雲端）
ANALYSIS_MODE=ocr

# OpenAI API Key（AI Vision 模式用，OCR 模式唔需要）
AI_VISION_API_KEY=

# Tesseract OCR 執行檔路徑（Windows 需要指定）
# 預設安裝路徑：C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# 輸出目錄
OUTPUT_DIR=./output

# OCR 信心度閾值（0.0 - 1.0，低於此值標記 needs_review）
CONFIDENCE_THRESHOLD=0.7
